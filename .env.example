# Copy this file to .env and fill in your own project's values.
# Supabase dashboard -> Project Settings -> API.
#
# Both are safe to expose client-side: this is the anon (publishable) key,
# not the service-role key. Never put a service-role key in a VITE_ var.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
